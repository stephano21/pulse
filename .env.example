# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).

POSTGRES_USER=pulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pulse

# Genera una clave larga y aleatoria: openssl rand -base64 48
JWTKey=changeme

# Client ID de "Aplicación web" en Google Cloud. Vacío => /v1/auth/google responde 503.
GOOGLE_CLIENT_ID=

# SMTP real para envío de correos en producción (vacío = envío de email deshabilitado)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_FROM_ADDRESS=noreply@stynger.online
EMAIL_SSL_MODE=StartTls

# Crea (una sola vez) esta cuenta como SuperAdmin del panel admin si aún no existe.
# Vacío = no siembra ninguna cuenta (usa App:SuperAdminEmails para promover una ya registrada).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
