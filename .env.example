# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).

POSTGRES_USER=pulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pulse

# Genera una clave larga y aleatoria: openssl rand -base64 48
JWTKey=changeme

# Client ID de "Aplicación web" en Google Cloud. Vacío => /v1/auth/google responde 503.
GOOGLE_CLIENT_ID=

# SMTP real para envío de correos en producción (EMAIL_HOST vacío = envío deshabilitado,
# cae al logger). Con Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_USER=tu-cuenta@gmail.com,
# EMAIL_PASSWORD=contraseña de aplicación (no la contraseña normal de la cuenta), y
# EMAIL_FROM_ADDRESS debe ser esa misma cuenta (o un alias de Workspace) — Gmail rechaza
# enviar "de" una dirección que no controlás (noreply@stynger.online no sirve como From acá).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@stynger.online
EMAIL_SSL_MODE=StartTls

# Storage S3-compatible para el logo del tenant y la foto de perfil (Cloudflare R2, Backblaze B2,
# AWS S3, MinIO...; STORAGE_SERVICE_URL vacío = subidas deshabilitadas, la API responde 503).
# Pensado para bucket PRIVADO: la API firma (presigned URL) cada lectura al vuelo, no expone el
# bucket públicamente ni necesita un dominio público delante.
#
# Cloudflare R2:
#   STORAGE_SERVICE_URL=https://<account_id>.r2.cloudflarestorage.com
#   STORAGE_ACCESS_KEY=... / STORAGE_SECRET_KEY=... (API token del bucket, no tu login de Cloudflare)
#   STORAGE_BUCKET=yapa-uploads
#   STORAGE_REGION=auto  (dejar el default, R2 no usa región real)
#
# AWS S3 (bucket privado normal, sin bloqueo público es lo que ya trae por defecto):
#   STORAGE_SERVICE_URL=https://s3.<region>.amazonaws.com   (ej. https://s3.us-east-1.amazonaws.com)
#   STORAGE_ACCESS_KEY=... / STORAGE_SECRET_KEY=... (de un usuario/rol IAM con permisos solo sobre ese bucket)
#   STORAGE_BUCKET=yapa-uploads
#   STORAGE_REGION=<la región real del bucket, ej. us-east-1> — con AWS esto SÍ importa (a diferencia
#   de R2): si no coincide con la región real del bucket, falla la firma de las URLs.
STORAGE_SERVICE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=auto

# Crea (una sola vez) esta cuenta como SuperAdmin del panel admin si aún no existe.
# Vacío = no siembra ninguna cuenta (usa App:SuperAdminEmails para promover una ya registrada).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
